generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  userId     Int    @id @default(autoincrement())
  email      String @unique
  password   String
  first_name String
  last_name  String

  githubAccount GithubAccount?
  tasks   Task[]
  conversations Conversation[]
}

model GithubAccount {
  id Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  githubUserId    BigInt             @unique
  githubUsername  String
  githubAvatarUrl String?
  repositories    GithubRepository[]

  githubAccessToken  String
  githubRefreshToken String
}

model GithubRepository {
  id Int @id @default(autoincrement())

  githubAccountId Int
  githubAccount   GithubAccount @relation(fields: [githubAccountId], references: [id], onDelete: Cascade)

  githubRepoId BigInt
  name         String
  fullName     String

  description   String?
  private       Boolean
  htmlUrl       String
  cloneUrl      String?
  defaultBranch String?
  tasks         Task[]
  conversations Conversation[]

  @@unique([githubAccountId, githubRepoId])
}

model Task{
  id        Int   @id      @default(autoincrement())
  userId    Int
  User      User  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  repositoryId Int?
  repository GithubRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  conversationId Int?
  thread Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversation    query[]
  status    Status    @default(pending)
  createdAt DateTime @default(now())
}

model Conversation {
  id Int @id @default(autoincrement())
  userId Int
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  repositoryId Int?
  repository GithubRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  title String
  containerId String?
  workingPatch String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages Message[]
  tasks Task[]

  @@index([userId, updatedAt])
}

model Message {
  id Int @id @default(autoincrement())
  conversationId Int
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role MessageRole
  content String
  mode MessageMode @default(chat)
  taskId Int?
  status MessageStatus @default(completed)
  createdAt DateTime @default(now())

  @@index([conversationId, id])
}

enum MessageRole {
  user
  assistant
}

enum MessageMode {
  chat
  code
}

enum MessageStatus {
  pending
  completed
  failed
}

model query{
  id        Int     @id     @default(autoincrement())
  query     String
  taskId    Int
  task      Task    @relation(fields: [taskId], references: [id])
  response  String
}

enum Status{
  pending
  runnning
  completed
  failed
}
